# Agent Platform 环境变量（本文件提交，.env 忽略；三层优先级：进程环境变量 > .env > Settings 默认值，见 6.2）
# 全量清单与默认值以《详细设计》附录 C 为准，键名由 tests/unit/test_config_docs_consistency.py 做一致性校验。

# ---- 基础 ----
APP_ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
SECRET_KEY=dev-only-change-me
ENCRYPTION_KEY=dev-only-change-me
CORS_ORIGINS=["http://localhost:5173"]
ENABLE_DOCS=true

# ---- LLM 默认值（新建 Provider 时的表单默认值） ----
# DeepSeek（OpenAI 兼容，已实测本机可直连）：
#   base_url 填 https://api.deepseek.com 即可（代码补 /v1；粘官方文档的
#   https://api.deepseek.com/chat/completions 也会被自动归一化）；
#   模型名填 deepseek-flash；thinking 默认开启，CoT 走 reasoning_content，
#   想关就把它写进 Provider 的 default_params：{"thinking": {"type": "disabled"}}；
#   DeepSeek 没有 /embeddings —— 知识库请另配一个支持 embeddings 的 Provider，
#   或开发环境用 EMBED_ALLOW_FAKE=true + backend 下 `python -m app.scripts.seed_demo --fake-embedding`。
LLM_DEFAULT_BASE_URL=https://api.openai.com/v1
LLM_DEFAULT_API_KEY=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_STREAM=true

# ---- 工具与沙箱（SD-17：危险的默认关闭，需显式开启） ----
SANDBOX_ROOT=./data/files
TOOL_DEFAULT_TIMEOUT_SECONDS=15
TOOL_MAX_OUTPUT_BYTES=65536
PYTHON_EXECUTE_ENABLED=false
FILE_WRITE_ENABLED=false

# ---- Agent Runtime ----
AGENT_MAX_STEPS=8
AGENT_RUN_TIMEOUT_SECONDS=180

# ---- 向量库（SD-11：只实现 chroma 与 memory） ----
VECTOR_STORE_KIND=chroma
CHROMA_DIR=./data/chroma
EMBED_ALLOW_FAKE=false
EMBEDDING_BATCH_SIZE=32

# ---- Trace / 并发 ----
TRACE_STORE_IO=true
TRACE_MAX_PAYLOAD_BYTES=8192
MAX_CONCURRENT_RUNS=4
EVAL_CONCURRENCY=2

# ---- 长任务与上传 ----
DETACH_CANCEL=false
TASK_RUNNER_CONCURRENCY=1
UPLOAD_MAX_BYTES=10485760

# ---- 外部工具（为空则该工具禁用） ----
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# ---- 数据根目录（data/ 下属 app.db / chroma / files / uploads / reports） ----
DATA_DIR=./data
